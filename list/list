#include <iostream>
using namespace std;
// 1. DẠNG 1: MẢNG ĐỘNG (LIST / DYNAMIC ARRAY)
class ArrayList {
private:
    int* data;
    int capacity;
    int size;

    void resize(int newCapacity) {
        int* temp = new int[newCapacity];
        for (int i = 0; i < size; i++) temp[i] = data[i];
        delete[] data;
        data = temp;
        capacity = newCapacity;
    }

public:
    ArrayList(int initialCap = 10) {
        capacity = initialCap;
        size = 0;
        data = new int[capacity];
    }

    ~ArrayList() { delete[] data; }

    // 1. Chèn đầu
    void insertHead(int val) {
        insertAt(val, 0);
    }

    // 2. Chèn cuối
    void insertTail(int val) {
        if (size == capacity) resize(capacity * 2);
        data[size++] = val;
    }

    // 3. Chèn vào vị trí i
    void insertAt(int val, int pos) {
        if (pos < 0 || pos > size) return;
        if (size == capacity) resize(capacity * 2);
        for (int i = size; i > pos; i--) {
            data[i] = data[i - 1];
        }
        data[pos] = val;
        size++;
    }

    // 4. Xóa đầu
    void deleteHead() {
        deleteAt(0);
    }

    // 5. Xóa cuối
    void deleteTail() {
        if (size > 0) size--;
    }

    // 6. Xóa tại vị trí i
    void deleteAt(int pos) {
        if (pos < 0 || pos >= size) return;
        for (int i = pos; i < size - 1; i++) {
            data[i] = data[i + 1];
        }
        size--;
    }

    // 7. Duyệt đầu -> cuối
    void printForward() {
        cout << "[Array Forward]: ";
        for (int i = 0; i < size; i++) cout << data[i] << " ";
        cout << endl;
    }

    // 8. Duyệt cuối -> đầu
    void printBackward() {
        cout << "[Array Backward]: ";
        for (int i = size - 1; i >= 0; i--) cout << data[i] << " ";
        cout << endl;
    }
};
